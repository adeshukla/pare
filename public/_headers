# Cloudflare Pages headers.
#
# COOP + COEP turn on SharedArrayBuffer, which lets the OxiPNG and AVIF encoders
# use their multi-threaded builds instead of falling back to a single core.
# Safe here because Pare loads nothing cross-origin - there is no server, no CDN
# script and no third-party asset to be blocked.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The service worker must never be served stale, or a deploy never takes over.
/sw.js
  Cache-Control: no-cache

# Everything under /assets/ has a content hash in its name, so it can never
# change under the same URL. Cache it for a year: a returning visitor then never
# re-downloads the encoders (several MB each), and the CDN serves them from the
# edge. This is most of what "scaling" means for a site with no server.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
