{
  "name": "pare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based asset optimizer. No install, no upload, no server.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run pages && vite",
    "build": "npm run pages && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "budget": "node scripts/check-budget.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run budget",
    "pages": "node scripts/make-task-pages.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "brotli-wasm": "^3.0.1",
    "comlink": "^4.4.2",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.1",
    "html-minifier-terser": "^7.2.0",
    "libheif-js": "^1.23.5",
    "lightningcss-wasm": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svgo": "^4.1.0",
    "terser": "^5.51.2",
    "thumbhash": "^0.1.1",
    "woff2-encoder": "^2.0.0"
  },
  "//devDependencies": {
    "typescript": "Held below 6.1: typescript-eslint@8 peers on typescript >=4.8.4 <6.1.0. TS 7 is released; taking it means dropping type-aware linting. Revisit when typescript-eslint supports it. See docs/STATUS.md."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.14.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
